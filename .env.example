# Build-time path. It must end with a slash.
VITE_BASE=/creative/

# Same-origin FYJIT integration endpoints and navigation.
CREATIVE_API_BASE=/api/creative
FYJIT_HOME_URL=/

# Exact corresponding source metadata for the running image.
FYJIT_CREATIVE_IMAGE=ghcr.io/jy027234/fyjit-infinite-canvas@sha256:REPLACE_WITH_DIGEST
SOURCE_COMMIT=COMMIT_SHA
SOURCE_URL=https://github.com/Jy027234/fyjit-infinite-canvas/tree/COMMIT_SHA

# Optional analytics. Leave empty to disable.
ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
